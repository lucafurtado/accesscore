FROM python:3.12-slim

WORKDIR /app

RUN apt-get update \
    && apt-get install -y --no-install-recommends libpq-dev gcc \
    && rm -rf /var/lib/apt/lists/*

COPY pyproject.toml .
RUN pip install --no-cache-dir -e .

COPY . .

# No --reload (dev-only) and no automatic "alembic upgrade head" here -
# migrations run as an explicit pre-deploy step instead (see the Render
# service's Pre-Deploy Command / DEPLOYMENT.md), so a redeploy can never
# race two containers' migrations against each other. Render injects PORT
# at runtime (default 10000); the app must bind to that, not a hardcoded
# port.
CMD ["sh", "-c", "uvicorn app.main:app --host 0.0.0.0 --port ${PORT:-8000}"]
