# Public: base URL the browser uses to call FastAPI directly for all
# authenticated data requests (Bearer token, no cookies involved).
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1

# Server-only: base URL the Next.js Route Handlers (the auth BFF) use to
# reach FastAPI for login/refresh/logout. Same value in local dev; kept
# separate from NEXT_PUBLIC_API_BASE_URL because in some deployments the
# server-side network path differs from the browser's.
BACKEND_API_URL=http://localhost:8000/api/v1
