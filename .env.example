# Copy to .env and fill in values. Never commit .env to git.

DATABASE_URL=postgresql+asyncpg://accesscore:accesscore@db:5432/accesscore

# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=change-this-to-a-random-32-char-string

DEBUG=true
# Never enable in production alongside DEBUG=true; use it standalone once
# DEBUG=false to keep /docs and /redoc visible without verbose error output.
ENABLE_API_DOCS=false
CORS_ORIGINS=["http://localhost:3000"]
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
BCRYPT_ROUNDS=12
